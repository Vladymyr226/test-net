{
  "ConnectionStrings": {
    "Primary": "Host=localhost;Port=55432;Database=t1db;Username=postgres;Password=postgres",
    "Replica": "Host=localhost;Port=55433;Database=t1db;Username=postgres;Password=postgres"
  },
  "Seed": {
    "Enabled": true,
    "Rows": 120000,
    "Months": 3,
    "Clients": 1000,
    "PendingShare": 0.01,
    "BatchSize": 20000
  },
  "Partitions": {
    "MonthsAhead": 2
  },
  "Replication": {
    "PublicationName": "t1_pub",
    "SubscriptionName": "t1_sub",
    "User": "replicator",
    "Password": "replicator",
    "PublisherHost": "pg-primary",
    "PublisherPort": 5432,
    "InitialSyncTimeoutSeconds": 120,
    "CheckIntervalSeconds": 60
  },
  "Jobs": {
    "AddOperation": { "Enabled": true, "Cron": "0/5 * * * * ?" },
    "ConfirmOperations": { "Enabled": true, "Cron": "0/3 * * * * ?" },
    "PartitionMaintenance": { "Enabled": true, "Cron": "0/10 * * * * ?" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*"
}
