# Template for docker compose settings: cp .env.example .env (local demo values only).

# PostgreSQL, both instances
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=t1db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TZ=UTC
PRIMARY_MAX_REPLICATION_SLOTS=10
PRIMARY_MAX_WAL_SENDERS=10
# WAL kept for a stalled subscription; beyond it the slot is lost and the service re-copies T1
PRIMARY_MAX_SLOT_WAL_KEEP_SIZE=2GB
REPLICA_MAX_LOGICAL_REPLICATION_WORKERS=4

# Host ports
T1_PRIMARY_PORT=55432
T1_REPLICA_PORT=55433
T1_API_PORT=8080

# .NET images used to build the service
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
ASPNETCORE_ENVIRONMENT=Production

# Logical replication (role used by the replica's subscription)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator
REPLICATION_SUBSCRIPTION=t1_sub
# how often the service re-checks (and repairs) the replica
REPLICATION_CHECK_INTERVAL_SECONDS=60

# Test data generated on first start (CALL t1_generate_data)
SEED_ENABLED=true
SEED_ROWS=120000
SEED_MONTHS=3
SEED_CLIENTS=1000
SEED_PENDING_SHARE=0.01
SEED_BATCH_SIZE=20000

# Scheduled jobs, Quartz cron: sec min hour day month weekday
JOB_ADD_OPERATION_ENABLED=true
JOB_ADD_OPERATION_CRON="0/5 * * * * ?"
JOB_CONFIRM_OPERATIONS_ENABLED=true
JOB_CONFIRM_OPERATIONS_CRON="0/3 * * * * ?"
JOB_PARTITION_MAINTENANCE_CRON="0/10 * * * * ?"
PARTITIONS_MONTHS_AHEAD=2
